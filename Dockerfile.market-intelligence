FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm install --no-save pg@8.16.3
COPY internal/dex-intelligence ./internal/dex-intelligence
ENV HOST=0.0.0.0
ENV PORT=8788
ENV MI_QUERY_CLIENT_MODULE=./query-client.pg.js
EXPOSE 8788
CMD ["node","internal/dex-intelligence/start-server.mjs"]
